[Unit]
Description=ConfTune FC Dynamic Power & Energy Performance Preference Daemon
Documentation=https://github.com/turajbjt/confTuneFc
After=multi-user.target systemd-udevd.service

[Service]
Type=simple
ExecStart=/usr/bin/conftune-fc --power-daemon
Restart=always
RestartSec=10
KillMode=process

# Sandboxing and security hardenings
ProtectHome=read-only
ProtectSystem=full
ReadWritePaths=/sys/devices/system/cpu
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_DAC_OVERRIDE

[Install]
WantedBy=multi-user.target
